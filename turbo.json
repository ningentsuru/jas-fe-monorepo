{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "tsconfig*.json",
        "**/*.ts",
        "**/*.tsx",
        "**/*.vue",
        "**/*.css",
        "nuxt.config.ts"
      ],
      "env": [
        "ENABLE_EXPERIMENTAL_COREPACK",
        "NODE_ENV",
        "NUXT_FORMSPREE_ENDPOINT_ID",
        "NUXT_GROQ_API_KEY",
        "NUXT_OPENAI_API_KEY"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".nuxt/**",
        ".output/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check-types": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "**/*.ts", "**/*.tsx", "**/*.vue"]
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.ts", "vitest.setup.ts", "**/*.ts", "**/*.vue"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "playwright.config.ts", "e2e/**"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
