{
  "extends": "@repo/typescript-config/vue.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui-vue": ["../../packages/ui-vue/src/index.ts"],
      "@repo/ui-vue/*": ["../../packages/ui-vue/src/*"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vitest.setup.ts"]
}
