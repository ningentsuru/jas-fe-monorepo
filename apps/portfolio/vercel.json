{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/activity-morse-code",
      "destination": "https://jas-next-morse-code.vercel.app/"
    },
    {
      "source": "/activity-morse-code/:path*",
      "destination": "https://jas-next-morse-code.vercel.app/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
